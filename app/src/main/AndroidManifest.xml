<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取已安装应用列表：添加应用时要列出桌面上的应用。
         保留这条权限，系统（HyperOS 等）才会在首次读取时弹「读取应用列表」授权框。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 检查更新 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:description="@string/app_desc"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NiXiang">

        <!-- 主界面：不导出，只允许应用内部（含 EntryActivity）启动。
             这样即使桌面图标隐藏了，也不会被第三方应用直接拉起。 -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.NiXiang"
            android:windowSoftInputMode="adjustResize" />

        <!-- 唯一对外入口：
             LSPosed 管理器解析「模块设置 / 右下角打开」时找的是这个 category，
             解析顺序 MODULE_SETTINGS → CATEGORY_INFO → CATEGORY_LAUNCHER，
             隐藏桌面图标不影响这里。 -->
        <activity
            android:name=".ui.EntryActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NiXiang"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面图标：由设置里的「显示桌面图标」开关启停（LauncherIconManager）。 -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".ui.EntryActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="点击应用内链接选择是否用内置浏览器打开" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />

        <!-- 选择框位置的跨进程读写口。宿主要把拖动后的位置写回来，只能走这里：
             libxposed 的远程配置在目标进程里是只读的。只处理 get/set 两个方法，
             写入值校验为两个 0~1 浮点，最坏情况只是弹窗位置不对。 -->
        <provider
            android:name=".data.ChooserPosProvider"
            android:authorities="io.github.sol01st.nobrowser.pos"
            android:enabled="true"
            android:exported="true" />
    </application>

</manifest>
